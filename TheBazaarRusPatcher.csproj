<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TheBazaarRusPatcher</AssemblyName>
    <RootNamespace>TheBazaarRusPatcher</RootNamespace>
    <Version>0.4.6</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDK default already excludes obj/** for Compile, but the new
         per-configuration intermediate directory layout (obj/<Name>/<Cfg>/...)
         can slip Debug AssemblyInfo into a Release publish. Belt-and-braces: -->
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="bin\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Patch\translation-patch.json">
      <LogicalName>Patch/translation-patch.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Patch\gamedata-tooltips.json">
      <LogicalName>Patch/gamedata-tooltips.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
